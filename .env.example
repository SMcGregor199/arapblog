PUBLIC_BOOKSHOP_STORE_URL=
PUBLIC_KIT_TIP_URL=

# Server-only Notion content configuration. Never prefix these with PUBLIC_.
NOTION_API_KEY=
NOTION_PUBLICATIONS_DATABASE_ID=
NOTION_CURATED_PIECES_DATABASE_ID=
NOTION_SELECTIONS_DATABASE_ID=
# Contributor records use a separate, isolated database configured before launch.
NOTION_CONTRIBUTORS_DATABASE_ID=
NOTION_NEWSLETTER_ISSUES_DATABASE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
CONTENT_RECONCILE_SECRET=
NEWSLETTER_RECOVERY_SECRET=
KIT_API_KEY=
KIT_TEMPLATE_ID=

# Set only in Netlify's Production Functions environment. Netlify's CONTEXT
# variable is build-only, so it cannot safely authorize runtime mutations.
ARAPBLOG_RUNTIME_CONTEXT=

# Daily Roundup research collector. Keep disabled until its production pilot is approved.
OPENAI_API_KEY=
ROUNDUP_RESEARCH_MODEL=gpt-5.6-terra
ROUNDUP_RESEARCH_ENABLED=false
# Notion @mention notification, sent once after a non-empty successful import.
# Set the user ID only if the connection cannot resolve Shayne by name.
NOTION_RESEARCH_NOTIFICATION_USER_ID=

# Never set ARAPBLOG_RUNTIME_CONTEXT=production locally or in a Deploy Preview;
# non-production contexts use the immutable code-backed preview snapshot and reject mutations.
