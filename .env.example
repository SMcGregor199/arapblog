PUBLIC_BOOKSHOP_STORE_URL=

# Server-only Notion content configuration. Never prefix these with PUBLIC_.
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
CONTENT_RECONCILE_SECRET=

# Local Astro development reads Notion directly when the two Notion values above
# are present. Set false to hide drafts from the local preview.
CONTENT_PREVIEW_DRAFTS=true
