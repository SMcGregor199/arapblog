PUBLIC_BOOKSHOP_STORE_URL=

# Server-only Notion content configuration. Never prefix these with PUBLIC_.
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Contributor records use a separate, isolated database configured before launch.
NOTION_CONTRIBUTORS_DATABASE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
CONTENT_RECONCILE_SECRET=

# Netlify supplies CONTEXT. Never set it to production for local or preview builds;
# non-production contexts use the immutable code-backed preview snapshot and reject mutations.
