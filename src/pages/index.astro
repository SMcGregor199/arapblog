---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { getEditorialSnapshot, publicationPath, publicationsOfType } from "../lib/content/editorial";
import { site } from "../data/site";
import type { EditorialSnapshot, PublicationType } from "../lib/content/types";
export const prerender = false;
let editorial: EditorialSnapshot = { schemaVersion:3, publications:[], curatedPieces:[], contributors:[], newsletterIssues:[] };
let unavailable=false;
try { editorial=await getEditorialSnapshot(); } catch { unavailable=true; Astro.response.status=503; }
const featured=editorial.publications.find((item)=>item.featured) ?? editorial.publications[0];
const sections: Array<{type:PublicationType;title:string;href:string;emptyLabel:string}> = [
  {type:"Essay",title:"Recent Essays",href:"/essays",emptyLabel:"Essays"},{type:"Roundup",title:"Recent Roundups",href:"/roundups",emptyLabel:"Roundups"},
  {type:"Collection",title:"Recent Collections",href:"/collections",emptyLabel:"Collections"},{type:"Listening Guide",title:"Recent Listening Guides",href:"/listening-guides",emptyLabel:"Listening Guides"},
];
const latestIssue=editorial.newsletterIssues[0];
---
<BaseLayout>
  <section class="editorial-hero"><div class="shell hero-editorial-grid"><div class="hero-statement"><p class="eyebrow">Independent rap criticism & curation</p><h1>{site.headline}</h1><p>Essays, weekly Roundups, thematic Collections, and Listening Guides—made by an editor, not an engagement feed.</p></div>
  {featured ? <article class="lead-story"><div class="lead-visual" data-accent={featured.accent} aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="lead-label">{featured.heroLabel}</span></div><div class="lead-copy"><p class="kicker">Featured · {featured.publicationType}</p><h2><a href={publicationPath(featured)}>{featured.title}</a></h2><p>{featured.description}</p><p class="lead-meta">By <a href={`/contributors/${featured.contributor}`}>{featured.contributor}</a></p></div></article> : <div class="lead-copy"><p class="kicker">The editorial desk is open</p><h2>New work is being prepared.</h2><p>The launch inventory will appear here after it has been written, selected, and reviewed by the editor.</p></div>}
  </div></section>
  {unavailable ? <section class="content-section"><div class="shell"><p role="status">Published work is temporarily unavailable. The last known good snapshot has not been replaced.</p></div></section> : sections.map(({type,title,href,emptyLabel}) => { const items=publicationsOfType(editorial,type).filter((item)=>item.slug!==featured?.slug).slice(0,3); return <section class="content-section originals-section"><div class="shell"><div class="section-heading"><div><p class="kicker">{type}</p><h2>{title}</h2></div><a class="text-link" href={href}>View all <span aria-hidden="true">→</span></a></div>{items.length?<div class="card-grid recent-grid">{items.map((publication)=><PublicationCard publication={publication}/>)}</div>:<p class="status-note">No {emptyLabel} are published yet.</p>}</div></section>; })}
  <section class="content-section"><div class="shell"><div class="section-heading"><div><p class="kicker">Monthly newsletter</p><h2>{latestIssue ? latestIssue.subject : "A month of A Rap Blog."}</h2></div>{latestIssue&&<a class="text-link" href={`/newsletter/${latestIssue.coverageMonth}`}>Read the issue <span aria-hidden="true">→</span></a>}</div><p>{latestIssue?.previewText ?? "A free monthly digest of every publication, with an editor’s note and no duplicate links."}</p></div></section>
  <NewsletterBand />
</BaseLayout>
<style>
  .editorial-hero{border-bottom:1px solid var(--line)}.hero-editorial-grid{display:grid;gap:clamp(3rem,7vw,7rem);padding-block:clamp(4rem,8vw,7rem)}.hero-statement{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:1.5rem 4rem;align-items:end}.hero-statement .eyebrow{grid-column:1/-1;justify-self:start}.hero-statement h1{max-width:10ch;font-size:clamp(4.3rem,11vw,9.5rem)}.hero-statement>p:last-child{max-width:38ch;color:var(--ink-soft);font-size:clamp(1.05rem,2vw,1.3rem)}.lead-story{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.15fr);border-top:1px solid var(--line-strong);padding-top:1.5rem;gap:clamp(2rem,6vw,6rem);align-items:center}.lead-visual{position:relative;min-height:330px;overflow:hidden;display:grid;place-items:center;border:1px solid var(--line-strong);background:var(--clay)}.lead-visual[data-accent="lime"]{background:var(--lime)}.lead-visual[data-accent="violet"]{background:var(--violet)}.orbit{position:absolute;width:75%;aspect-ratio:1;border:1px solid var(--ink);border-radius:50%}.orbit-two{width:45%}.lead-label{z-index:1;max-width:15ch;padding:.6rem .8rem;background:var(--paper);font-family:var(--mono);font-size:.72rem;font-weight:800;text-align:center;text-transform:uppercase;rotate:-3deg}.lead-copy h2{max-width:13ch;margin-top:1rem;font-size:clamp(2.6rem,6vw,5.5rem)}.lead-copy h2 a{text-decoration:none}.lead-copy>p:not(.kicker,.lead-meta){max-width:46ch;margin-top:1.5rem;color:var(--ink-soft)}.lead-meta{margin-top:1.5rem;font-family:var(--mono);font-size:.72rem;text-transform:uppercase}.originals-section:nth-of-type(even){background:var(--paper-deep)}@media(max-width:800px){.hero-statement,.lead-story{grid-template-columns:1fr}.hero-statement .eyebrow{grid-column:auto}.lead-visual{min-height:240px}}
</style>
