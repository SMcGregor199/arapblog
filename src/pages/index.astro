---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterBand from "../components/NewsletterBand.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featured = articles.find((article) => article.data.featured) || articles[0];
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">For the fan finding their way back</p>
        <h1>Rap moved on.<br /><em>You can catch up.</em></h1>
        <p class="hero-deck">
          Start with an artist you already know. Leave with a short, opinionated path to what
          deserves your attention next.
        </p>
        <div class="hero-actions">
          <a class="button" href={featured ? `/articles/${featured.id}` : "/articles"}>
            Start a listening path <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/about">How this works</a>
        </div>
      </div>
      <div class="route-art" aria-label="A winding listening route across a record">
        <div class="route-record" aria-hidden="true">
          <span class="route-dot dot-one"></span>
          <span class="route-dot dot-two"></span>
          <span class="route-dot dot-three"></span>
          <span class="route-label">Start where<br />you are</span>
        </div>
        <p class="route-caption">No canon test. No algorithm fog. Just the next right record.</p>
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="shell manifesto-grid">
      <p class="kicker">The idea</p>
      <p>
        You do not need to hear everything. You need a trusted way into <em>something</em>.
      </p>
      <p class="manifesto-note">
        Every guide makes a case, sequences the route, and gives you one clear place to press
        play.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">Fresh paths</p>
          <h2>Pick a place to begin.</h2>
        </div>
        <p>
          Cross eras without losing the thread. These are maps, not rankings—and you can take
          the detours that suit you.
        </p>
      </div>
      <div class="card-grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="method">
    <div class="shell method-grid">
      <div class="method-title">
        <p class="kicker">Our listening method</p>
        <h2>Familiar → adjacent → surprising.</h2>
      </div>
      <ol>
        <li>
          <span>01</span>
          <div>
            <h3>Anchor the path</h3>
            <p>Begin with a voice, album, or era that already means something to you.</p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>Follow the connective tissue</h3>
            <p>Move through writing, production, perspective, or influence—not vague similarity.</p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>End somewhere new</h3>
            <p>Finish with a record you may not have chosen without the route that led there.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <NewsletterBand />
</BaseLayout>

<style>
  .home-hero {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    min-height: min(780px, calc(100svh - 82px));
    grid-template-columns: minmax(0, 1.25fr) minmax(340px, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  h1 {
    max-width: 11ch;
    margin-top: 1.8rem;
    font-size: clamp(4rem, 9vw, 8.2rem);
  }

  h1 em {
    position: relative;
    color: var(--clay);
    font-weight: 500;
  }

  h1 em::after {
    position: absolute;
    right: 0;
    bottom: -0.08em;
    left: 0;
    height: 0.08em;
    background: var(--lime);
    content: "";
    rotate: -1deg;
  }

  .hero-deck {
    max-width: 48ch;
    margin-top: 2rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-top: 2.3rem;
  }

  .text-link {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .route-art {
    display: grid;
    justify-items: center;
  }

  .route-record {
    position: relative;
    display: grid;
    width: min(100%, 410px);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--paper) 0 8%, var(--ink) 8.5% 10%, transparent 10.5%),
      repeating-radial-gradient(circle, transparent 0 14px, rgba(23, 19, 15, 0.5) 15px 17px),
      var(--violet);
    box-shadow:
      14px 14px 0 var(--clay),
      28px 28px 0 var(--ink);
  }

  .route-record::before {
    position: absolute;
    width: 69%;
    height: 45%;
    border: 3px dashed var(--lime);
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    content: "";
    rotate: 22deg;
  }

  .route-label {
    z-index: 1;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
    rotate: -6deg;
  }

  .route-dot {
    position: absolute;
    z-index: 2;
    width: 1.1rem;
    aspect-ratio: 1;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--lime);
  }

  .dot-one {
    top: 18%;
    left: 28%;
  }

  .dot-two {
    top: 31%;
    right: 16%;
  }

  .dot-three {
    right: 31%;
    bottom: 12%;
  }

  .route-caption {
    max-width: 32ch;
    margin-top: 3.4rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-align: center;
    text-transform: uppercase;
  }

  .manifesto {
    padding-block: 3rem;
    border-bottom: 1px solid var(--line);
    background: var(--lime);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 0.5fr 1.5fr 0.8fr;
    align-items: start;
    gap: 3rem;
  }

  .manifesto-grid > p:nth-child(2) {
    max-width: 24ch;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    line-height: 1.1;
  }

  .manifesto-note {
    font-size: 0.88rem;
  }

  .method {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-top: 1px solid var(--line);
    background: var(--paper-deep);
  }

  .method-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .method-title h2 {
    max-width: 11ch;
    margin-top: 1rem;
    font-size: clamp(2.8rem, 6vw, 5rem);
  }

  .method ol {
    padding: 0;
    list-style: none;
  }

  .method li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .method li:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .method li > span {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .method h3 {
    font-size: 1.55rem;
  }

  .method li p {
    max-width: 44ch;
    margin-top: 0.55rem;
    color: var(--ink-soft);
  }

  @media (max-width: 850px) {
    .hero-grid,
    .method-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      min-height: auto;
    }

    .route-record {
      max-width: 310px;
    }

    .manifesto-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: clamp(3.4rem, 18vw, 5rem);
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
