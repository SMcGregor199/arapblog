---
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionCard from "../components/CollectionCard.astro";
import CuratedLinkCard from "../components/CuratedLinkCard.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import { site } from "../data/site";
import { getEditorialSnapshot } from "../lib/content/editorial";
import type { EditorialSnapshot } from "../lib/content/types";

export const prerender = false;

let editorial: EditorialSnapshot = {
  schemaVersion: 2,
  originals: [],
  curatedLinks: [],
  collections: [],
  contributors: [],
};
let unavailable = false;
try {
  editorial = await getEditorialSnapshot();
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
const featured = editorial.originals.find((article) => article.featured) || editorial.originals[0];
const recent = editorial.originals.filter((article) => article.slug !== featured?.slug).slice(0, 3);
const collection = editorial.collections[0];
const topics = [...new Set([
  ...editorial.originals.flatMap((article) => article.tags),
  ...editorial.curatedLinks.flatMap((item) => item.topics),
])].slice(0, 10);
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, s-maxage=30, stale-while-revalidate=120, durable",
);
---

<BaseLayout>
  <section class="editorial-hero">
    <div class="shell hero-editorial-grid">
      <div class="hero-statement">
        <p class="eyebrow">Independent rap criticism & curation</p>
        <h1>{site.headline}</h1>
        <p>
          Original arguments, reported stories, deep histories, and a reading list chosen by
          editors—not an engagement feed.
        </p>
      </div>
      {featured && (
        <article class="lead-story">
          <div class="lead-visual" data-accent={featured.accent} aria-hidden="true">
            <span class="orbit orbit-one"></span>
            <span class="orbit orbit-two"></span>
            <span class="lead-label">{featured.heroLabel}</span>
          </div>
          <div class="lead-copy">
            <p class="kicker">Featured · {featured.contentType}</p>
            <h2><a href={`/articles/${featured.slug}`}>{featured.title}</a></h2>
            <p>{featured.description}</p>
            <p class="lead-meta">By <a href={`/contributors/${featured.author}`}>{featured.author}</a> · {featured.readTime}</p>
          </div>
        </article>
      )}
    </div>
  </section>

  {unavailable ? (
    <section class="content-section"><div class="shell"><p role="status">Published stories are temporarily unavailable. The last known good snapshot has not been replaced.</p></div></section>
  ) : (
    <>
      <section class="content-section originals-section">
        <div class="shell">
          <div class="section-heading">
            <div><p class="kicker">Originals</p><h2>Recent stories</h2></div>
            <a class="text-link" href="/articles">All stories <span aria-hidden="true">→</span></a>
          </div>
          <div class="card-grid recent-grid">
            {recent.map((article) => <ArticleCard article={article} />)}
          </div>
        </div>
      </section>

      <section class="reading-section">
        <div class="shell reading-layout">
          <div class="reading-intro">
            <p class="kicker">The reading list</p>
            <h2>Worth leaving this site for.</h2>
            <p>Eight pieces from writers and publications doing careful work around rap.</p>
            <a class="text-link" href="/reading">Open the archive <span aria-hidden="true">→</span></a>
          </div>
          <div class="reading-list">
            {editorial.curatedLinks.slice(0, 8).map((item, index) => <CuratedLinkCard item={item} index={index} />)}
          </div>
        </div>
      </section>

      {collection && (
        <section class="collection-section">
          <div class="shell collection-feature">
            <div class="collection-signal" aria-hidden="true"><span>ARB</span></div>
            <CollectionCard collection={collection} />
          </div>
        </section>
      )}

      <section class="topics-section">
        <div class="shell topics-layout">
          <div><p class="kicker">Follow a thread</p><h2>Topics</h2></div>
          <ul class="topic-cloud">
            {topics.map((topic) => (
              <li><a href={`/topics/${topic.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{topic}</a></li>
            ))}
          </ul>
        </div>
      </section>
    </>
  )}

  <NewsletterBand />
</BaseLayout>

<style>
  .editorial-hero { border-bottom: 1px solid var(--line); }
  .hero-editorial-grid { display: grid; gap: clamp(3rem, 7vw, 7rem); padding-block: clamp(4rem, 8vw, 7rem); }
  .hero-statement { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr); gap: 1.5rem 4rem; align-items: end; }
  .hero-statement .eyebrow { grid-column: 1 / -1; justify-self: start; }
  .hero-statement h1 { max-width: 10ch; font-size: clamp(4.3rem, 11vw, 9.5rem); }
  .hero-statement > p:last-child { max-width: 38ch; color: var(--ink-soft); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .lead-story { display: grid; grid-template-columns: minmax(280px, .85fr) minmax(0, 1.15fr); border-top: 1px solid var(--line-strong); padding-top: 1.5rem; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .lead-visual { position: relative; min-height: 330px; overflow: hidden; display: grid; place-items: center; border: 1px solid var(--line-strong); background: var(--clay); }
  .lead-visual[data-accent="lime"] { background: var(--lime); }
  .lead-visual[data-accent="violet"] { background: var(--violet); }
  .orbit { position: absolute; width: 75%; aspect-ratio: 1; border: 1px solid var(--ink); border-radius: 50%; }
  .orbit-two { width: 45%; }
  .lead-label { z-index: 1; max-width: 15ch; padding: .6rem .8rem; background: var(--paper); font-family: var(--mono); font-size: .72rem; font-weight: 800; text-align: center; text-transform: uppercase; rotate: -3deg; }
  .lead-copy h2 { max-width: 13ch; margin-top: 1rem; font-size: clamp(2.6rem, 6vw, 5.5rem); }
  .lead-copy h2 a { text-decoration: none; }
  .lead-copy > p:not(.kicker, .lead-meta) { max-width: 46ch; margin-top: 1.5rem; color: var(--ink-soft); }
  .lead-meta { margin-top: 1.5rem; font-family: var(--mono); font-size: .72rem; text-transform: uppercase; }
  .originals-section { background: var(--paper-deep); }
  .reading-section { padding-block: clamp(4rem, 10vw, 9rem); border-top: 1px solid var(--line); }
  .reading-layout { display: grid; grid-template-columns: minmax(240px, .55fr) minmax(0, 1.45fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .reading-intro { position: sticky; top: 2rem; }
  .reading-intro h2 { max-width: 8ch; margin-top: 1rem; font-size: clamp(2.8rem, 6vw, 5.5rem); }
  .reading-intro > p:not(.kicker) { max-width: 31ch; margin-top: 1.5rem; color: var(--ink-soft); }
  .reading-intro .text-link { display: inline-block; margin-top: 1.5rem; }
  .collection-section { padding-block: clamp(4rem, 8vw, 7rem); background: var(--ink); color: var(--paper); }
  .collection-feature { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .collection-signal { display: grid; min-height: 330px; place-items: center; border: 1px solid rgba(243,239,229,.35); background: radial-gradient(circle, var(--coral, var(--clay)) 0 7%, transparent 8%), repeating-radial-gradient(circle, transparent 0 22px, rgba(243,239,229,.18) 23px 25px), var(--teal, var(--violet)); }
  .collection-signal span { padding: .6rem .8rem; background: var(--paper); color: var(--ink); font-family: var(--mono); font-weight: 800; rotate: 5deg; }
  .topics-section { padding-block: clamp(4rem, 8vw, 7rem); }
  .topics-layout { display: grid; grid-template-columns: .5fr 1.5fr; gap: 3rem; }
  .topics-layout h2 { margin-top: .7rem; font-size: clamp(2.6rem, 5vw, 4.5rem); }
  .topic-cloud { display: flex; flex-wrap: wrap; gap: .75rem; padding: 0; list-style: none; }
  .topic-cloud a { display: block; padding: .7rem 1rem; border: 1px solid var(--line-strong); border-radius: 999px; text-decoration: none; }
  @media (max-width: 800px) {
    .hero-statement, .lead-story, .reading-layout, .collection-feature, .topics-layout { grid-template-columns: 1fr; }
    .hero-statement .eyebrow { grid-column: auto; }
    .reading-intro { position: static; }
    .lead-visual { min-height: 240px; }
  }
</style>
