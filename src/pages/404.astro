---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page could not be found.">
  <section class="not-found">
    <div class="shell">
      <p class="eyebrow">404 / Wrong turn</p>
      <h1>This path skips.</h1>
      <p>The page moved, never existed, or fell out of the crate.</p>
      <a class="button" href="/">Return to A Rap Blog</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 65svh;
    place-items: center;
    padding-block: 5rem;
    text-align: center;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(4rem, 12vw, 9rem);
  }

  p:not(.eyebrow) {
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .button {
    margin-top: 2rem;
  }
</style>
