---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="About"
  description="Why A Rap Blog publishes Essays, Roundups, Collections, and Listening Guides, and the standards behind all four."
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">About the publication</p>
      <h1>The writing rap deserves.</h1>
      <p>
        {site.name} publishes Essays, weekly Roundups, thematic Collections, and Listening Guides.
        Outside work is always fully credited and linked at its canonical source.
      </p>
    </div>
  </header>
  <section class="content-section">
    <div class="shell">
      <div class="info-grid">
        <article class="info-card">
          <p class="kicker">01 / Essays & guides</p>
          <h2>Arguments, not volume</h2>
          <p>
            Work publishes when there is a real point of view, useful reporting, or context that
            changes how a reader hears the music. Daily churn is not the goal.
          </p>
        </article>
        <article class="info-card">
          <p class="kicker">02 / Roundups & Collections</p>
          <h2>Credit travels with the link</h2>
          <p>
            Curated pieces keep the writer, publication, original date, canonical URL, and our
            reason for choosing them visible. The title always leads to the original publisher.
          </p>
        </article>
        <article class="info-card">
          <p class="kicker">03 / Independence</p>
          <h2>The mission comes first</h2>
          <p>
            Support and newsletter prompts stay quiet. Commercial relationships are disclosed, and
            no commission or partnership buys editorial placement.
          </p>
        </article>
      </div>
      <div class="legal-copy author-note">
        <h2>Who is vestige?</h2>
        <p>
          vestige is the founding editor and first contributor. Invited writers will receive
          credited profile pages and retain their own bylines. The publication is not accepting
          open submissions at launch.
        </p>
        <p>
          Questions or corrections? Email
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .author-note {
    margin-top: 5rem;
  }
</style>
