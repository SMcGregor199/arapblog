---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { getEditorialSnapshot } from "../lib/content/editorial";
export const prerender=false;
const editorial=await getEditorialSnapshot();
---
<BaseLayout title="Newsletter" description="The free monthly A Rap Blog newsletter and its public archive.">
  <header class="page-hero"><div class="shell"><p class="eyebrow">One note a month</p><h1>Every publication. Once a month.</h1><p>An editor’s note followed by that month’s Essays, Roundups, Collections, and Listening Guides. No duplicate links and no daily churn.</p></div></header>
  <section class="content-section"><div class="shell signup-grid"><div class="signup-panel"><p class="kicker">Join the list</p><form class="signup-form" action={site.newsletterFormAction} method="post"><label for="email">Email address</label><input id="email" name="email_address" type="email" autocomplete="email" required/><button class="button" type="submit" data-umami-event="Newsletter signup page">Join the list</button></form><p class="privacy-note">Subscriptions use double opt-in. Every issue includes an unsubscribe link. Read the <a href="/privacy">privacy policy</a>.</p></div><div class="issue-preview"><p class="kicker">Sent issues</p>{editorial.newsletterIssues.length?<ul>{editorial.newsletterIssues.map((issue)=><li><a href={`/newsletter/${issue.coverageMonth}`}>{issue.subject}</a><span>{issue.coverageMonth}</span></li>)}</ul>:<p>The public archive begins after the first issue is manually sent.</p>}</div></div></section>
</BaseLayout>
<style>.signup-grid{display:grid;grid-template-columns:1fr .8fr;gap:clamp(2rem,7vw,6rem);align-items:start}.signup-panel,.issue-preview{padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line-strong);background:var(--panel)}.signup-panel{box-shadow:8px 8px 0 var(--clay)}.signup-form{display:grid;gap:.7rem;margin-top:1.2rem}.signup-form label{font-size:.8rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.signup-form input{min-height:50px;padding:.8rem;border:1px solid var(--ink);background:var(--paper)}.privacy-note{margin-top:1rem;color:var(--ink-soft);font-size:.82rem}.issue-preview ul{display:grid;gap:1rem;margin-top:1rem;padding:0;list-style:none}.issue-preview li{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--line);padding-top:1rem}.issue-preview span{font-family:var(--mono);font-size:.7rem}@media(max-width:760px){.signup-grid{grid-template-columns:1fr}}</style>
