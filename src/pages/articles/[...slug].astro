---
import { getLiveEntry } from "astro:content";
import ArticleBody from "../../components/ArticleBody";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isLiveEntryNotFoundError } from "../../lib/content/repository";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const result = await getLiveEntry("articles", { slug });
const article = result.entry?.data;
const unavailable =
  Boolean(result.error) && !isLiveEntryNotFoundError(result.error);

if (unavailable) {
  Astro.response.status = 503;
} else if (!article) {
  Astro.response.status = 404;
}
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, s-maxage=30, stale-while-revalidate=120, durable",
);
---

{
  unavailable ? (
    <BaseLayout
      title="Content temporarily unavailable"
      description="This story is temporarily unavailable."
    >
      <section class="page-hero">
        <div class="shell">
          <p class="eyebrow">Temporary interruption</p>
          <h1>That story is unavailable right now.</h1>
          <p>Please try again shortly. The last published version has not been replaced.</p>
        </div>
      </section>
    </BaseLayout>
  ) : article ? (
    <ArticleLayout article={article}>
      <ArticleBody bodyMarkdown={article.bodyMarkdown} />
    </ArticleLayout>
  ) : (
    <BaseLayout title="Story not found" description="That story does not exist.">
      <section class="page-hero">
        <div class="shell">
          <p class="eyebrow">404</p>
          <h1>That story does not exist.</h1>
          <p><a href="/articles">Browse every story.</a></p>
        </div>
      </section>
    </BaseLayout>
  )
}
