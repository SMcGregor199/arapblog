---
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = false;
const retired = new Set(["nas-reference-point","no-homework-kendrick-lamar-guide","rap-books-that-improve-listening"]);
const gone = retired.has(Astro.params.slug ?? "");
Astro.response.status = gone ? 410 : 404;
Astro.response.headers.set("Cache-Control", "public, max-age=300");
---
<BaseLayout title={gone ? "Publication retired" : "Page not found"} description={gone ? "This publication has been permanently removed." : "That publication does not exist."}><section class="page-hero"><div class="shell"><p class="eyebrow">{gone ? "410" : "404"}</p><h1>{gone ? "This publication has been retired." : "That publication does not exist."}</h1><p><a href="/">Return to A Rap Blog.</a></p></div></section></BaseLayout>
