---
import { getLiveCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = false;

const result = await getLiveCollection("articles");
const articles = (result.entries ?? []).map((entry) => entry.data);
if (result.error) Astro.response.status = 503;
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, s-maxage=30, stale-while-revalidate=120, durable",
);
---

<BaseLayout
  title="Listening paths"
  description="Every A Rap Blog listening path, artist guide, and reading recommendation."
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">The full stack</p>
      <h1>Every listening path.</h1>
      <p>
        Begin with what you know, choose the connection that interests you, and stop when your
        queue feels alive again.
      </p>
    </div>
  </header>
  <section class="content-section">
    <div class="shell">
      <div class="card-grid">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
      {
        result.error && (
          <p role="status">
            Listening paths are temporarily unavailable. Please try again shortly.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
