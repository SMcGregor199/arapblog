---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEditorialSnapshot } from "../../lib/content/editorial";
import { editorialSlug } from "../../lib/editorial-routing";

export const prerender = false;
const editorial = await getEditorialSnapshot();
const counts = new Map<string, { name: string; count: number }>();
for (const topic of [...editorial.originals.flatMap((item) => item.tags), ...editorial.curatedLinks.flatMap((item) => item.topics)]) {
  const slug = editorialSlug(topic);
  const current = counts.get(slug);
  counts.set(slug, { name: current?.name ?? topic, count: (current?.count ?? 0) + 1 });
}
const topics = [...counts.entries()].sort((a, b) => b[1].count - a[1].count || a[1].name.localeCompare(b[1].name));
---

<BaseLayout title="Topics" description="Browse A Rap Blog’s original stories and selected reading by subject, scene, artist, and form.">
  <header class="page-hero"><div class="shell"><p class="eyebrow">Follow a thread</p><h1>Topics</h1><p>Move across originals and outside reading without losing the subject that brought you in.</p></div></header>
  <section class="content-section"><div class="shell"><ul class="topic-index">
    {topics.map(([slug, topic]) => <li><a href={`/topics/${slug}`}><span>{topic.name}</span><small>{topic.count} {topic.count === 1 ? "piece" : "pieces"}</small></a></li>)}
  </ul></div></section>
</BaseLayout>

<style>
  .topic-index { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding: 0; list-style: none; }
  .topic-index a { display: flex; min-height: 150px; flex-direction: column; justify-content: space-between; padding: 1.4rem; border: 1px solid var(--line-strong); background: var(--panel); text-decoration: none; }
  .topic-index span { font-family: var(--serif); font-size: 1.8rem; }
  .topic-index small { font-family: var(--mono); text-transform: uppercase; }
  @media (max-width: 760px) { .topic-index { grid-template-columns: 1fr; } }
</style>
