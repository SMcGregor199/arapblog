---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">Record</span>
          <span>{site.name}</span>
        </a>
        <p class="footer-note">
          Original criticism and a careful reading list. Built for attention, not churn.
        </p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/articles">Stories</a>
        <a href="/reading">Reading</a>
        <a href="/topics">Topics</a>
        <a href="/about">About</a>
        <a href="/newsletter">Newsletter</a>
        <a href="/affiliate-disclosure">Affiliate disclosure</a>
        <a href="/privacy">Privacy</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
    <p class="copyright">
      © {new Date().getFullYear()} {site.name}. Selection and criticism remain editorially independent.
    </p>
  </div>
</footer>
