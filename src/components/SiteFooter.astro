---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">Record</span>
          <span>{site.name}</span>
        </a>
        <p class="footer-note">
          Essays, Roundups, Collections, and Listening Guides. Built for attention, not churn.
        </p>
      </div>
      <div class="footer-navigation">
        <nav class="footer-link-group" aria-label="Publications">
          <p>Browse</p>
          <div>
            <a href="/essays">Essays</a>
            <a href="/roundups">Roundups</a>
            <a href="/collections">Collections</a>
            <a href="/listening-guides">Listening Guides</a>
          </div>
        </nav>
        <nav class="footer-link-group" aria-label="Site information">
          <p>Information</p>
          <div>
            <a href="/about">About</a>
            <a href="/newsletter">Newsletter</a>
            <a href="/affiliate-disclosure">Affiliate disclosure</a>
            <a href="/privacy">Privacy</a>
            <a href="/rss.xml">RSS</a>
          </div>
        </nav>
      </div>
    </div>
    <p class="copyright">
      © {new Date().getFullYear()} {site.name}. Selection and criticism remain editorially independent.
    </p>
  </div>
</footer>
