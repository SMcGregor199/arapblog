---
import type { CuratedPiece } from "../lib/content/types";
interface Props { item: CuratedPiece; index?: number }
const { item, index } = Astro.props;
const date = new Date(item.originalDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<article class="reading-item">
  {index !== undefined && <span class="reading-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
  <div class="reading-main">
    <p class="reading-source"><span>{item.sourcePublication}</span><time datetime={item.originalDate}>{date}</time></p>
    <h3><a href={item.canonicalUrl} rel="external">{item.title}<span class="sr-only"> (external link at {item.sourcePublication})</span><span class="outbound" aria-hidden="true">↗</span></a></h3>
    <p class="reading-byline">By {item.writer}</p>
    <p class="reading-note">{item.annotation}</p>
    <ul class="topic-list" aria-label="Topics">{item.topics.map((topic) => <li><span>{topic}</span></li>)}</ul>
  </div>
</article>
