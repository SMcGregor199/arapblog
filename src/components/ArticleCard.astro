---
import type { Article } from "../lib/content/types";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const publishedAt = new Date(article.publishedAt);
const date = publishedAt.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<article class="article-card">
  <a
    class="card-art"
    data-accent={article.accent}
    href={`/articles/${article.slug}`}
    aria-label={`Read ${article.title}`}
  >
    <span>{article.heroLabel}</span>
  </a>
  <div class="card-body">
    <div class="card-meta">
      <span>{article.contentType}</span>
      <time datetime={publishedAt.toISOString()}>{date}</time>
    </div>
    <h3><a href={`/articles/${article.slug}`}>{article.title}</a></h3>
    <p>{article.description}</p>
    <p class="card-byline">
      By <a href={`/contributors/${article.author}`}>{article.author}</a>
    </p>
    <a class="card-link" href={`/articles/${article.slug}`}>Read story</a>
  </div>
</article>
