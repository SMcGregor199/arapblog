---
import type { Article } from "../lib/content/types";
import BaseLayout from "./BaseLayout.astro";
import NewsletterBand from "../components/NewsletterBand.astro";
import SupportCard from "../components/SupportCard.astro";
import { site } from "../data/site";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const bookshopStoreUrl = import.meta.env.PUBLIC_BOOKSHOP_STORE_URL;
const hasActiveAffiliateLinks = article.hasAffiliateLinks;
const publishedAt = new Date(article.publishedAt);
const updatedAt = new Date(article.updatedAt);
const published = publishedAt.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  author: {
    "@type": "Person",
    name: article.author,
    url: `${site.url}/contributors/${article.author}`,
  },
  publisher: { "@type": "Organization", name: site.name, url: site.url },
  mainEntityOfPage: `${site.url}/articles/${article.slug}`,
};
---

<BaseLayout
  title={article.title}
  description={article.description}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header class="article-hero">
      <div class="shell article-hero-grid">
        <div class="article-intro">
          <div class="article-meta">
            <span>{article.contentType}</span>
            <time datetime={publishedAt.toISOString()}>{published}</time>
            <span>{article.readTime}</span>
          </div>
          <h1>{article.title}</h1>
          <p>{article.description}</p>
          <p class="byline">By <a href={`/contributors/${article.author}`}>{article.author}</a></p>
        </div>
        {article.heroImage ? (
          <figure class="article-hero-image">
            <img src={article.heroImage.src} alt={article.heroImage.alt} width="820" height="820" />
            {article.heroImage.credit && (
              <figcaption>
                {article.heroImage.creditUrl ? (
                  <a href={article.heroImage.creditUrl} rel="external">{article.heroImage.credit}</a>
                ) : article.heroImage.credit}
              </figcaption>
            )}
          </figure>
        ) : (
          <div class="hero-record" data-accent={article.accent} role="img" aria-label={article.heroAlt}>
            <span>{article.heroLabel}</span>
          </div>
        )}
      </div>
    </header>
    <div class="shell article-grid">
      <aside class="article-rail">
        <p class="kicker">Editorial standard</p>
        <p>A clear argument, honest sourcing, and enough room for the music to remain complicated.</p>
      </aside>
      <div class="prose">
        {
          hasActiveAffiliateLinks && (
            <p class="affiliate-note">
              I may earn a commission if you buy through links in this post, at no extra cost to
              you. Recommendations remain editorially independent.
            </p>
          )
        }
        <slot />
        {
          article.hasAffiliateLinks && bookshopStoreUrl && (
            <aside class="bookshop-card">
              <div>
                <p class="kicker">Independent-bookstore option</p>
                <h2>Browse the reading shelf.</h2>
                <p>
                  Purchases through this Bookshop.org link may earn A Rap Blog a commission while
                  supporting independent bookstores.
                </p>
              </div>
              <a
                class="button"
                href={bookshopStoreUrl}
                rel="external nofollow sponsored"
                data-umami-event="Bookshop affiliate click"
              >
                Open Bookshop.org
              </a>
            </aside>
          )
        }
        <SupportCard />
      </div>
    </div>
  </article>
  <NewsletterBand />
</BaseLayout>

<style>
  .article-hero {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }

  .article-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin-top: 1.5rem;
    font-size: clamp(3rem, 7.5vw, 6.7rem);
  }

  .article-intro > p:not(.byline) {
    max-width: 48ch;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: 1.15rem;
  }

  .byline {
    margin-top: 2rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-record {
    position: relative;
    display: grid;
    overflow: hidden;
    width: min(100%, 410px);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, transparent 0 14px, rgba(23, 19, 15, 0.4) 15px 17px),
      var(--clay);
    box-shadow: 12px 12px 0 var(--ink);
  }

  .article-hero-image {
    margin: 0;
  }

  .article-hero-image img {
    width: min(100%, 410px);
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    box-shadow: 12px 12px 0 var(--ink);
  }

  .article-hero-image figcaption {
    max-width: 410px;
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .hero-record[data-accent="lime"] {
    background:
      repeating-radial-gradient(circle, transparent 0 14px, rgba(23, 19, 15, 0.4) 15px 17px),
      var(--lime);
  }

  .hero-record[data-accent="violet"] {
    background:
      repeating-radial-gradient(circle, transparent 0 14px, rgba(23, 19, 15, 0.4) 15px 17px),
      var(--violet);
  }

  .hero-record::after {
    position: absolute;
    width: 2.8rem;
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    content: "";
  }

  .hero-record span {
    z-index: 1;
    max-width: 15ch;
    padding: 0.5rem 0.7rem;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    rotate: -5deg;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 740px);
    gap: clamp(2rem, 6vw, 6rem);
    justify-content: center;
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .article-rail {
    position: sticky;
    top: 2rem;
    align-self: start;
    padding-top: 0.8rem;
    border-top: 4px solid var(--clay);
    color: var(--ink-soft);
    font-size: 0.86rem;
  }

  .article-rail p + p {
    margin-top: 0.8rem;
  }

  .prose {
    min-width: 0;
    font-family: var(--serif);
    font-size: clamp(1.08rem, 2vw, 1.22rem);
    line-height: 1.72;
  }

  .prose :global(h2) {
    margin-top: 3.8rem;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
  }

  .prose :global(h3) {
    margin-top: 2.8rem;
    font-size: clamp(1.55rem, 4vw, 2.2rem);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-top: 1.35rem;
  }

  .prose :global(li + li) {
    margin-top: 0.75rem;
  }

  .prose :global(strong) {
    color: var(--clay-dark);
  }

  .prose :global(a) {
    overflow-wrap: anywhere;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    box-shadow: 7px 7px 0 var(--paper-deep);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: 0.92rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line-strong);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--lime);
  }

  .prose :global(pre) {
    overflow-x: auto;
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.12em 0.3em;
    background: var(--paper-deep);
    font-family: var(--mono);
    font-size: 0.88em;
  }

  .prose :global(input[type="checkbox"]) {
    margin-right: 0.5rem;
  }

  .prose :global(blockquote) {
    padding: 1.2rem 1.4rem;
    border-left: 6px solid var(--lime);
    background: var(--panel);
    font-size: 1.2em;
    font-style: italic;
  }

  .prose :global(.path-stop) {
    margin-top: 2.8rem;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    box-shadow: 6px 6px 0 var(--paper-deep);
  }

  .prose :global(.path-stop h3) {
    margin-top: 0;
  }

  .prose :global(.listen-next) {
    font-family: var(--sans);
    font-size: 0.9rem;
  }

  .affiliate-note {
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .bookshop-card {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--ink);
    background: var(--lime);
    font-family: var(--sans);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .bookshop-card h2 {
    margin-top: 0.45rem;
    font-size: 2rem;
  }

  .bookshop-card p:not(.kicker) {
    margin-top: 0.6rem;
  }

  @media (max-width: 850px) {
    .article-hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-record {
      max-width: 310px;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-rail {
      position: static;
    }

    .bookshop-card {
      grid-template-columns: 1fr;
    }
  }
</style>
